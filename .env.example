# ---------------------------------------------------------------------------
# Docker image
# ---------------------------------------------------------------------------
BASE_IMAGE=zed_ros2_l4t_36.3.0_sdk_5.0.0
IMAGE_TAG=dev
CONTAINER_NAME=autonomypark-homebrew

# ---------------------------------------------------------------------------
# ROS 2 / DDS
# ---------------------------------------------------------------------------
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# true:
#   Load config/fastdds/super_client_config.xml and connect as a
#   Fast DDS Discovery Server SUPER_CLIENT
#
# false:
#   Use normal Fast DDS discovery
USE_DISCOVERY_SERVER=true

# Seconds the entrypoint waits for a default route (i.e. Wi-Fi up) before
# exiting so Docker restarts the container
NETWORK_WAIT_TIMEOUT=120
# Seconds to wait for NTP to set the clock; starts anyway after this
CLOCK_WAIT_TIMEOUT=60

# ---------------------------------------------------------------------------
# ZED camera
# ---------------------------------------------------------------------------
LAUNCH_ZED=true
ZED_MODEL=zed2i
ZED_CAMERA_NAME=zed
ZED_NAMESPACE=homebrew
ZED_SERIAL=12345678

# ---------------------------------------------------------------------------
# MAVROS
# ---------------------------------------------------------------------------
LAUNCH_MAVROS=true
FCU_URL=/dev/ttyFC:921600
MAVROS_NAMESPACE=homebrew
# Must match the FCU's MAV_SYS_ID and be unique on the network (e.g. the
# homebrew number). MAVROS links its router and plugins over the absolute
# topics /uas<N>/mavlink_{source,sink}, which the namespace does NOT apply
# to - two vehicles with the same ID will receive (and command!) each other.
MAVROS_TGT_SYSTEM=1
MAVROS_RESPAWN=true
