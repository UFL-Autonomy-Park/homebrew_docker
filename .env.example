# ---------------------------------------------------------------------------
# Docker image
# ---------------------------------------------------------------------------
BASE_IMAGE=zed_ros2_l4t_36.3.0_sdk_5.0.0
IMAGE_TAG=dev
CONTAINER_NAME=autonomypark-homebrew

# ---------------------------------------------------------------------------
# ROS 2 / DDS
# ---------------------------------------------------------------------------
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# true:
#   Load config/fastdds/client_config.xml and connect as a
#   Fast DDS Discovery Server CLIENT
#
# false:
#   Use normal Fast DDS discovery
USE_DISCOVERY_SERVER=true

# Seconds the entrypoint waits for wlan0 to get an IPv4 address and a default
# route (Wi-Fi up) before exiting so Docker restarts the container
NETWORK_WAIT_TIMEOUT=120
# Seconds the entrypoint waits for the clock to agree with the lab time server
# (192.168.1.201) before exiting so Docker restarts the container. ROS never
# starts on an unsynced clock (docs/TIME_SYNC.md)
CLOCK_WAIT_TIMEOUT=60

# ---------------------------------------------------------------------------
# ZED camera
# ---------------------------------------------------------------------------
LAUNCH_ZED=true
ZED_MODEL=zed2i
ZED_CAMERA_NAME=zed
ZED_SERIAL=12345678

# ---------------------------------------------------------------------------
# Flight-controller bridge: MAVROS or Micro XRCE-DDS Agent (README section 8)
# ---------------------------------------------------------------------------
# Set EXACTLY ONE of these to true. Both use the FCU serial port below; the
# launch refuses to start with both. The FCU's TELEM2 must be configured to
# match (MAVLink for MAVROS, uXRCE-DDS for the agent). autonomy_park_sitl
# needs MAVROS.
LAUNCH_MAVROS=true
LAUNCH_XRCE_AGENT=false
# Serial port and baud for whichever bridge runs (MAVROS URL format)
FCU_URL=/dev/ttyFC:921600

# ---------------------------------------------------------------------------
# MAVROS
# ---------------------------------------------------------------------------
MAVROS_NAMESPACE=homebrew
# Must match the FCU's MAV_SYS_ID and be unique on the network (e.g. the
# homebrew number). MAVROS links its router and plugins over the absolute
# topics /uas<N>/mavlink_{source,sink}, which the namespace does NOT apply
# to - two vehicles with the same ID will receive (and command!) each other.
# Never 1: the Astros are fixed at 1.
MAVROS_TGT_SYSTEM=2
# MAVROS plugin list from config/mavros/: "full" (upstream PX4 default,
# ~60 plugins) or "minimal" (only what autonomy_park_sitl uses + RTK).
MAVROS_PLUGINS=minimal
# WARNING: FULL causes MAVROS to use a lot of CPU and memory, causing high latency and the drone may crash!!!!
# DO not use "full" unless you're debuggging!!!
# MAVLink stream rates to request from the FCU on every (re)connection, as
# <message id>:<Hz>,... Empty (the default) leaves PX4's rates alone. Mind
# the serial bandwidth before raising rates (README section 9). Example, 100 Hz
# for altitude, global_position/* and local_position/*:
#   MAVLINK_RATES=141:100,33:100,32:100
MAVLINK_RATES=

# ---------------------------------------------------------------------------
# RTK (NTRIP client -> MAVROS gps_rtk -> FCU)
# ---------------------------------------------------------------------------
# Requires UAVCAN_PUB_RTCM=1 on the FCU (DroneCAN GPS, e.g. Here4). If the
# caster is unreachable the client just retries; MAVROS is unaffected.
# Only runs with MAVROS (LAUNCH_MAVROS=true): with the XRCE agent there is no
# path for corrections to the FCU, and the client is not started.
LAUNCH_NTRIP=true
NTRIP_HOST=192.168.1.201
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=BASE
NTRIP_USERNAME=discoveryrtk
NTRIP_PASSWORD=givemertknowplease
